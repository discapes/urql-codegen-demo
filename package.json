{
	"name": "svelte-graphql-demo",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"codegen": "(test -f codegen.yml || node codegen.js) && graphql-codegen --config codegen.yml"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "^7.0.0",
		"@graphql-codegen/client-preset": "^6.0.0",
		"@graphql-codegen/introspection": "^6.0.0",
		"@graphql-codegen/typescript": "^6.0.0",
		"@graphql-typed-document-node/core": "^3.1.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"dotenv": "^18.0.0",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte3": "^4.0.0",
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^4.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte2tsx": "^0.7.0",
		"tslib": "^2.4.1",
		"typescript": "^7.0.0",
		"vite": "^8.0.0",
		"yaml": "^2.2.1"
	},
	"type": "module",
	"dependencies": {
		"@urql/core": "^6.0.0"
	}
}
